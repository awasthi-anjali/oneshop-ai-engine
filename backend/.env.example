# OpenAI API key (optional — app works with rule-based fallback without it)
OPENAI_API_KEY=

# Model to use when OpenAI is configured
OPENAI_MODEL=gpt-4o-mini

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Receipt email — optional (configure one)
# Resend: https://resend.com/api-keys (test mode sends only to your Resend account email)
# RESEND_API_KEY=

# Eva Gmail SMTP: https://myaccount.google.com/apppasswords
# EVA_GMAIL_APP_PASSWORD=
