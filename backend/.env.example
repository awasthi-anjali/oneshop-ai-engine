# OpenAI API key (optional — app works with rule-based fallback without it)
OPENAI_API_KEY=

# Model to use when OpenAI is configured
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
SHOPASSIST_INTENT_MODEL=gpt-5.6-luna

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Kill switches for durable simulated ordering (no real payment processing)
ORDERING_ENABLED=true
DEMO_PAYMENT_ENABLED=true
