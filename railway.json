{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/backend/**",
      "/requirements.txt",
      "/railway.json",
      "/.python-version"
    ]
  },
  "deploy": {
    "startCommand": "uvicorn app.main:app --app-dir backend --host 0.0.0.0 --port $PORT --workers 1 --proxy-headers",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "drainingSeconds": 20
  }
}
